# pnpm's default fetch resilience (3 retries, 10s-60s backoff) is too thin
# for a large binary tarball (e.g. next/@next/swc-* platform binaries)
# against a registry under sustained load -- observed directly during
# Pilot Product Experience Residual Closure (Tranche H3/H4): the exact
# same two packages timed out identically across 6+ consecutive
# `docker compose build` runs, never a different package, ruling out
# random bad luck and pointing to a real, sustained registry-side
# incident on this specific day. Raising retries/timeouts costs nothing
# on a healthy registry and turns a registry blip into a slower build
# instead of a hard failure; capping network-concurrency lowers the
# number of simultaneous connections competing for the same throttled
# endpoint, which can raise the odds any single one completes.
fetch-retries=8
fetch-retry-mintimeout=20000
fetch-retry-maxtimeout=180000
fetch-timeout=600000
network-concurrency=4
