# Quest City Web — STAGING environment template (Tranche E, 07_06 §5/§9).
# Copy to a gitignored `.env.staging` on the staging host (or inject these
# same variables via the secret mechanism chosen at implementation time —
# 07_06 §9 rule 1: "conservazione in secret store o file protetti fuori dal
# repository"). This file, like `.env.example`, carries NO real values —
# only names, defaults-that-are-safe-to-publish, and generation instructions.
#
# Every value below is DISTINCT from local dev and from any other
# environment (Tranche E design report §15: "no staging secret may be
# committed... no staging→production credential reuse"). Do not copy a
# value from `.env.example` or from `infrastructure/deployment/docker-compose.yml`
# into this file — those carry deliberately non-secret local/CI placeholders
# (`changeme_local_only`) that must NEVER appear in staging.
#
# STAGING_ENV_STRICT gates the fail-fast guard (tools/validate-staging-env.mjs,
# run as the `staging-guard` compose service before `api` starts) — see
# docker-compose.staging.yml. Local dev and CI never set this variable, so
# their behavior is completely unaffected by anything in this file.
STAGING_ENV_STRICT=true

# --- Shared ---
NODE_ENV=production
LOG_LEVEL=info

# --- apps/api ---
API_PORT=4000
# Generate a strong, staging-only password — never `changeme_local_only`,
# never reused from any other environment. Used TWICE below: once to start
# Postgres itself (STAGING_POSTGRES_PASSWORD, read directly by
# docker-compose.staging.yml's postgres service) and once embedded in
# DATABASE_URL (read by apps/api) — both MUST be the same value, or the API
# will fail to authenticate.
STAGING_POSTGRES_PASSWORD=
# sslmode=require enforces DATABASE_SSL=true end-to-end (also set
# explicitly below, since the API reads DATABASE_SSL independently of the
# connection string's own sslmode parameter).
DATABASE_URL=postgresql://quest_city_web:REPLACE_WITH_SAME_VALUE_AS_STAGING_POSTGRES_PASSWORD@postgres:5432/quest_city_web?sslmode=require
# MANDATORY for staging (ACN/MePA Gap Analysis GAP-09; Tranche E design
# report §10). The staging-guard refuses to start the stack if this is not
# exactly "true".
DATABASE_SSL=true
HEALTH_READY_DB_TIMEOUT_MS=2000

# --- Tranche E — per-pool connection tuning (design report §19) ---
# Reduces the theoretical worst-case connection count from 45 (today's
# hardcoded values) to 26, and recycles idle connections instead of holding
# them open indefinitely. These are E-PILOT starting values, not fixed
# constants — recalibrate after the load test called for in 07_06 §20.
DB_POOL_HEALTH_MAX=2
DB_POOL_HEALTH_IDLE_TIMEOUT_MS=10000
DB_POOL_ATTEMPTS_MAX=8
DB_POOL_ATTEMPTS_IDLE_TIMEOUT_MS=30000
DB_POOL_ATTEMPTS_CONNECTION_TIMEOUT_MS=5000
DB_POOL_IDENTITY_MAX=6
DB_POOL_IDENTITY_IDLE_TIMEOUT_MS=30000
DB_POOL_IDENTITY_CONNECTION_TIMEOUT_MS=5000
DB_POOL_STAFF_IDENTITY_MAX=6
DB_POOL_STAFF_IDENTITY_IDLE_TIMEOUT_MS=30000
DB_POOL_STAFF_IDENTITY_CONNECTION_TIMEOUT_MS=5000
DB_POOL_PLATFORM_IDENTITY_MAX=4
DB_POOL_PLATFORM_IDENTITY_IDLE_TIMEOUT_MS=30000
DB_POOL_PLATFORM_IDENTITY_CONNECTION_TIMEOUT_MS=5000

# --- apps/student-web / apps/dashboard ---
STUDENT_WEB_PORT=3000
DASHBOARD_PORT=3001
# Real staging domain — replace before deploy. The API is reached through
# the same TLS edge (nginx.staging.conf routes /api/ internally), so both
# apps point at the public HTTPS origin, not an internal hostname/port.
NEXT_PUBLIC_API_BASE_URL=https://REPLACE_WITH_STAGING_DOMAIN/api
NEXT_PUBLIC_API_BASE_URL_DASHBOARD=https://REPLACE_WITH_STAGING_DOMAIN/api

# --- Session / cookies ---
SESSION_COOKIE_NAME=qc_web_session
SESSION_ABSOLUTE_TTL_SECONDS=43200
SESSION_INACTIVITY_TTL_SECONDS=3600
# Real staging origin only — NEVER include a localhost origin here (the
# staging-guard checks for this).
WEB_AUTH_TRUSTED_ORIGINS=https://REPLACE_WITH_STAGING_DOMAIN
# MUST be unset (or "false") in staging — the application code already
# refuses this override outside NODE_ENV=development regardless of this
# variable's value (apps/api/lib/env.ts), but the staging-guard also checks
# it explicitly as a second, independent line of defense.
SESSION_COOKIE_SECURE_OVERRIDE_INSECURE_LOCAL=false

# --- Staff session / cookies ---
STAFF_SESSION_COOKIE_NAME=qc_staff_session
STAFF_SESSION_ABSOLUTE_TTL_SECONDS=43200
STAFF_SESSION_INACTIVITY_TTL_SECONDS=3600
STAFF_AUTH_TRUSTED_ORIGINS=https://REPLACE_WITH_STAGING_DOMAIN

# --- Platform Admin session / cookies ---
PLATFORM_SESSION_COOKIE_NAME=qc_platform_session
PLATFORM_SESSION_ABSOLUTE_TTL_SECONDS=43200
PLATFORM_SESSION_INACTIVITY_TTL_SECONDS=3600
PLATFORM_AUTH_TRUSTED_ORIGINS=https://REPLACE_WITH_STAGING_DOMAIN

# HMAC-SHA-256 key for class-code hashing. REQUIRED, no default, staging-only
# value — generate once per environment with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Tranche E design report §14: rotating this value invalidates every
# already-issued class-code hash — treat rotation as a rare, planned event
# (see the Credential Rotation Runbook), not a periodic one.
CLASS_CODE_HASH_PEPPER=

# --- Backup (infrastructure/scripts/backup-staging-db.sh wraps tools/backup-staging-db.mjs) ---
# AES-256-GCM key for encrypting backup dumps at rest before upload
# (Tranche E design report §21). Generate once, store in the secret
# mechanism, NEVER commit. 32 random bytes, base64-encoded:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BACKUP_ENCRYPTION_KEY=
# Destination adapter: "local" (default, a stand-in target for local/staging
# validation — see Tranche E design report §18) or "fs" pointing at an
# already-mounted off-site path (e.g. an EU object-storage bucket mounted
# via a provider-specific gateway/CSI driver chosen at implementation time —
# no provider is selected here). Do NOT mark GAP-02 closed based on the
# "local" adapter alone — off-site validation is a separate, later step.
BACKUP_TARGET_ADAPTER=local
BACKUP_TARGET_PATH=/var/backups/quest-city-web/offsite
BACKUP_RETENTION_DAILY=14
BACKUP_RETENTION_WEEKLY=8
BACKUP_RETENTION_MONTHLY=6

# --- Monitoring (tools/staging-healthcheck.mjs) ---
STAGING_HEALTH_BASE_URL=https://REPLACE_WITH_STAGING_DOMAIN
# Optional webhook for alert delivery (Tranche E design report §28) — left
# empty means "log only", never a hardcoded default destination.
STAGING_ALERT_WEBHOOK_URL=
STAGING_DISK_PATH=/
STAGING_DISK_ALERT_THRESHOLD_PERCENT=85
STAGING_CERT_EXPIRY_ALERT_DAYS=14

# --- PostgreSQL TLS (infrastructure/scripts/generate-staging-db-tls.sh) ---
# Paths to the server cert/key generated by that script into a gitignored
# directory — see infrastructure/database/staging-tls/README.md.
POSTGRES_TLS_CERT_PATH=infrastructure/database/staging-tls/generated/server.crt
POSTGRES_TLS_KEY_PATH=infrastructure/database/staging-tls/generated/server.key
