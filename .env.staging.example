# Quest City Web — STAGING environment template (Tranche E1; 07_06 §5/§9).
# Copy to a gitignored `.env.staging` on the staging host (or inject these
# same variables via the secret mechanism chosen at E3 implementation time
# — 07_06 §9 rule 1: "conservazione in secret store o file protetti fuori
# dal repository"). This file, like `.env.example`, carries NO real values
# — only names, defaults-that-are-safe-to-publish, and generation
# instructions.
#
# Every value below is DISTINCT from local dev and from any other
# environment — no staging secret may be committed, no staging->production
# credential reuse. Do not copy a value from `.env.example` or from
# `infrastructure/deployment/docker-compose.yml` into this file — those
# carry deliberately non-secret local/CI placeholders
# (`changeme_local_only`) that must NEVER appear in staging.
#
# STAGING_ENV_STRICT gates the fail-fast guard (tools/validate-staging-env.mjs,
# run as the `staging-guard` compose service before `api` starts) — see
# docker-compose.staging.yml. Local dev and CI never set this variable, so
# their behavior is completely unaffected by anything in this file.
STAGING_ENV_STRICT=true

# --- Shared ---
NODE_ENV=production
LOG_LEVEL=info

# --- apps/api ---
API_PORT=4000
# Generate a strong, staging-only password — never `changeme_local_only`,
# never reused from any other environment. This is the ONLY place the
# staging Postgres password is entered: docker-compose.staging.yml derives
# BOTH Postgres's own `POSTGRES_PASSWORD` AND apps/api's `DATABASE_URL`
# from this single variable via Compose `${STAGING_POSTGRES_PASSWORD}`
# substitution — there is no separate `DATABASE_URL=` line to keep in sync
# by hand (an earlier design that required manually copying this value
# into a second line was found, via a real end-to-end boot test, to be a
# needless mismatch risk — fixed by deriving instead of duplicating).
STAGING_POSTGRES_PASSWORD=
# MANDATORY for staging (ACN/MePA Gap Analysis GAP-09; internal Postgres
# TLS, infrastructure/database/staging-tls/**). The staging-guard refuses
# to start the stack if this is not exactly "true".
DATABASE_SSL=true
HEALTH_READY_DB_TIMEOUT_MS=2000

# --- Per-pool connection tuning (design report §19) ---
# Reduces the theoretical worst-case connection count from 45 (the
# hardcoded values every pool used before these variables existed) to 26,
# and recycles idle connections instead of holding them open indefinitely.
# These are E-PILOT starting values, not fixed constants — recalibrate
# after the load test called for in 07_06 §20.
DB_POOL_HEALTH_MAX=2
DB_POOL_HEALTH_IDLE_TIMEOUT_MS=10000
DB_POOL_ATTEMPTS_MAX=8
DB_POOL_ATTEMPTS_IDLE_TIMEOUT_MS=30000
DB_POOL_ATTEMPTS_CONNECTION_TIMEOUT_MS=5000
DB_POOL_IDENTITY_MAX=6
DB_POOL_IDENTITY_IDLE_TIMEOUT_MS=30000
DB_POOL_IDENTITY_CONNECTION_TIMEOUT_MS=5000
DB_POOL_STAFF_IDENTITY_MAX=6
DB_POOL_STAFF_IDENTITY_IDLE_TIMEOUT_MS=30000
DB_POOL_STAFF_IDENTITY_CONNECTION_TIMEOUT_MS=5000
DB_POOL_PLATFORM_IDENTITY_MAX=4
DB_POOL_PLATFORM_IDENTITY_IDLE_TIMEOUT_MS=30000
DB_POOL_PLATFORM_IDENTITY_CONNECTION_TIMEOUT_MS=5000

# --- apps/student-web / apps/dashboard ---
STUDENT_WEB_PORT=3000
DASHBOARD_PORT=3001
# Real staging domain — replace before deploy. The API is reached through
# the same TLS edge (nginx.staging.conf routes /api/ internally), so both
# apps point at the public HTTPS origin, not an internal hostname/port.
NEXT_PUBLIC_API_BASE_URL=https://REPLACE_WITH_STAGING_DOMAIN/api
NEXT_PUBLIC_API_BASE_URL_DASHBOARD=https://REPLACE_WITH_STAGING_DOMAIN/api

# --- Session / cookies ---
SESSION_COOKIE_NAME=qc_web_session
SESSION_ABSOLUTE_TTL_SECONDS=43200
SESSION_INACTIVITY_TTL_SECONDS=3600
# Real staging origin only — NEVER include a localhost origin here (the
# staging-guard checks for this).
WEB_AUTH_TRUSTED_ORIGINS=https://REPLACE_WITH_STAGING_DOMAIN
# MUST be unset (or "false") in staging — the application code already
# refuses this override outside NODE_ENV=development regardless of this
# variable's value (apps/api/lib/env.ts), but the staging-guard also checks
# it explicitly as a second, independent line of defense.
SESSION_COOKIE_SECURE_OVERRIDE_INSECURE_LOCAL=false

# --- Staff session / cookies ---
STAFF_SESSION_COOKIE_NAME=qc_staff_session
STAFF_SESSION_ABSOLUTE_TTL_SECONDS=43200
STAFF_SESSION_INACTIVITY_TTL_SECONDS=3600
STAFF_AUTH_TRUSTED_ORIGINS=https://REPLACE_WITH_STAGING_DOMAIN

# --- Platform Admin session / cookies ---
PLATFORM_SESSION_COOKIE_NAME=qc_platform_session
PLATFORM_SESSION_ABSOLUTE_TTL_SECONDS=43200
PLATFORM_SESSION_INACTIVITY_TTL_SECONDS=3600
PLATFORM_AUTH_TRUSTED_ORIGINS=https://REPLACE_WITH_STAGING_DOMAIN

# HMAC-SHA-256 key for class-code hashing. REQUIRED, no default, staging-only
# value — generate once per environment with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Rotating this value invalidates every already-issued class-code hash —
# treat rotation as a rare, planned event (see the Credential Rotation
# Runbook), not a periodic one.
CLASS_CODE_HASH_PEPPER=

# --- Master Admin Operations Control Center: Telegram alert channel (02_42 §30, 07_06 §9) ---
# OPTIONAL, same contract as local dev/CI (.env.example): set BOTH or
# NEITHER, never just one — apps/api/lib/operations-context.ts falls back
# to LocalMockAlertChannelAdapter automatically when either is unset.
# NEVER a NEXT_PUBLIC_* variable, never read by student-web or dashboard,
# never logged. `infrastructure/scripts/bootstrap.sh` provisions
# `alert_configuration.recipient_ref`/`credential_ref` automatically and
# idempotently once both are set (tools/provision-telegram-alert-channel.ts)
# — no manual SQL UPDATE is ever required, in staging any more than local.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Tranche E2 out-of-band external monitoring, Level 2 (02_42 v1.2 PARTE U
# §53-54, AGENTS.md §4.31) ---
# OPTIONAL, same contract as .env.example. NEVER the Telegram Bot Token
# above (AGENTS.md §4.31 rule 4) — an independent secret with its own
# lifecycle, stored here (server-side) and in GitHub Actions
# repository/environment secrets for the external monitor workflow (not
# created by this change set, 02_42 §62). Never NEXT_PUBLIC_*, never read by
# student-web or dashboard, never logged. _CURRENT/_PREVIOUS mirror the
# CURRENT/PREVIOUS key-id rows in external_monitor_key_metadata (§54) — the
# database only ever holds the key-id/status metadata, never these values.
EXTERNAL_MONITOR_HMAC_SECRET_CURRENT=
EXTERNAL_MONITOR_HMAC_SECRET_PREVIOUS=
# Provisioning-only key-id labels (micro-closure mission §5), consumed by
# tools/provision-external-monitor-key.ts during deploy/bootstrap -- never
# read by the running API process itself. See .env.example for the full
# rationale.
EXTERNAL_MONITOR_HMAC_KEY_ID_CURRENT=
EXTERNAL_MONITOR_HMAC_KEY_ID_PREVIOUS=

# --- Backup (tools/backup-staging-db.mjs / tools/restore-staging-db.mjs) ---
# AES-256-GCM key for encrypting backup dumps at rest before upload.
# Generate once, store in the secret mechanism, NEVER commit. 32 random
# bytes, base64-encoded:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BACKUP_ENCRYPTION_KEY=
# Destination adapter: "local" (a stand-in filesystem target — proves the
# pipeline, is NOT off-site) or "s3" (a real off-site target — Tranche E3,
# closes GAP-02). Set to "s3" and fill in the BACKUP_S3_* block below to
# actually close GAP-02; "local" alone never does, regardless of how many
# times the backup script succeeds.
BACKUP_TARGET_ADAPTER=local
BACKUP_TARGET_PATH=/var/backups/quest-city-web/offsite
# --- s3 adapter config (only read when BACKUP_TARGET_ADAPTER=s3) ---
# Provider-neutral: any S3-compatible endpoint works (Cloudflare R2,
# Backblaze B2, Hetzner Object Storage, MinIO, AWS S3 itself, ...). Scope
# the access key to this one bucket only, never an account-wide key.
# BACKUP_S3_BUCKET=
# BACKUP_S3_ENDPOINT=              # e.g. https://<account-id>.r2.cloudflarestorage.com
# BACKUP_S3_REGION=auto            # "auto" is correct for R2; use the real region for other providers
# BACKUP_S3_ACCESS_KEY_ID=
# BACKUP_S3_SECRET_ACCESS_KEY=
# BACKUP_S3_PREFIX=quest-city-web-staging   # optional key prefix inside the bucket
# Cost-control alert only (not a governance/compliance requirement) — sends
# one Telegram message via the same TELEGRAM_BOT_TOKEN/TELEGRAM_CHAT_ID
# above when bucket usage reaches the threshold. Defaults (10 GiB / 90%)
# match Cloudflare R2's free tier; override for a different provider/plan.
# See tools/check-backup-storage-usage.mjs.
# BACKUP_S3_STORAGE_LIMIT_BYTES=10737418240
# BACKUP_S3_STORAGE_ALERT_THRESHOLD_PERCENT=90
BACKUP_RETENTION_DAILY=14
BACKUP_RETENTION_WEEKLY=8
BACKUP_RETENTION_MONTHLY=6

# --- Container images (Tranche E3, 07_06 §4.1) ---
# Staging never builds application images from source — it runs exactly
# what CI built, scanned, and pushed to GHCR, pinned by immutable digest
# (never a floating tag, never `latest` — §4.2). Values come from the
# `container-scan` CI job's step summary for the commit being deployed —
# see infrastructure/runbooks/01-deployment.md.
API_IMAGE_REF=ghcr.io/REPLACE_WITH_OWNER/quest-city-web-api@sha256:REPLACE_WITH_DIGEST
STUDENT_WEB_IMAGE_REF=ghcr.io/REPLACE_WITH_OWNER/quest-city-web-student-web@sha256:REPLACE_WITH_DIGEST
DASHBOARD_IMAGE_REF=ghcr.io/REPLACE_WITH_OWNER/quest-city-web-dashboard@sha256:REPLACE_WITH_DIGEST

# --- PostgreSQL internal TLS ---
# No variable needed here: docker-compose.staging.yml mounts
# infrastructure/database/staging-tls/generated/{server.crt,server.key}
# directly (generated locally via generate-staging-db-tls.sh, gitignored,
# never referenced by an env var). See that directory's README.md.

# Deliberately NOT included below (Tranche E1 scope excludes G8 / the
# out-of-band monitoring redesign — see the Tranche E reconciliation
# report): STAGING_HEALTH_BASE_URL, STAGING_ALERT_WEBHOOK_URL,
# STAGING_DISK_PATH, STAGING_DISK_ALERT_THRESHOLD_PERCENT,
# STAGING_CERT_EXPIRY_ALERT_DAYS. Those belong to tools/staging-healthcheck.mjs,
# which this mission does not port (it would create a second, parallel
# alerting path alongside the Master Admin Operations Control Center's
# Telegram pipeline) — that redesign is Tranche E2.
