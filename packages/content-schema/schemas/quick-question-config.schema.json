{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.questcity.dev/web/quick-question-config.schema.json",
  "title": "QuickQuestionConfig",
  "description": "R3C.1. Configuration for ENG-QUICK / QC-WEB-ENGINE-QUICK-QUESTION (07_10 §7, ratified R3C.0A). mode OPTION_SELECTION (baseline) or ENTER_VALUE (simple numeric answer, NOT QC-WEB-ENGINE-NUMERIC-INPUT). mode ITEM_SET (Tranche 2, M06 Web Full Vertical Slice, 07_13 §6) wraps a sequence of single-item configs to represent the QUICK_QUESTION_SET stage as one canonical stage/one engine dispatch, per 02_36 stage-orchestration boundary (item progression is engine-owned, not orchestrator-owned).",
  "type": "object",
  "$defs": {
    "itemFeedback": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "correctFeedbackText": { "type": "string", "minLength": 1 },
        "incorrectFeedbackText": { "type": "string", "minLength": 1 },
        "solutionExplanation": { "type": "string", "minLength": 1 },
        "misconceptions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["code", "feedbackText"],
            "properties": {
              "matchChoiceId": { "type": "string", "minLength": 1 },
              "code": { "type": "string", "minLength": 1 },
              "feedbackText": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    }
  },
  "oneOf": [
    {
      "additionalProperties": false,
      "required": ["mode", "options", "correctOptionId"],
      "properties": {
        "mode": { "const": "OPTION_SELECTION" },
        "options": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["optionId"],
            "properties": { "optionId": { "type": "string", "minLength": 1 } }
          }
        },
        "correctOptionId": { "type": "string", "minLength": 1 }
      }
    },
    {
      "additionalProperties": false,
      "required": ["mode", "expectedValue", "tolerance"],
      "properties": {
        "mode": { "const": "ENTER_VALUE" },
        "expectedValue": { "type": "number" },
        "tolerance": { "type": "number", "minimum": 0 }
      }
    },
    {
      "additionalProperties": false,
      "required": ["mode", "items"],
      "properties": {
        "mode": { "const": "ITEM_SET" },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["itemId", "mode", "prompt", "options", "correctOptionId"],
                "properties": {
                  "itemId": { "type": "string", "minLength": 1 },
                  "mode": { "const": "OPTION_SELECTION" },
                  "prompt": { "type": "string", "minLength": 1 },
                  "options": {
                    "type": "array",
                    "minItems": 2,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["optionId", "text"],
                      "properties": {
                        "optionId": { "type": "string", "minLength": 1 },
                        "text": { "type": "string", "minLength": 1 }
                      }
                    }
                  },
                  "correctOptionId": { "type": "string", "minLength": 1 },
                  "feedback": { "$ref": "#/$defs/itemFeedback" }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["itemId", "mode", "prompt", "expectedValue", "tolerance"],
                "properties": {
                  "itemId": { "type": "string", "minLength": 1 },
                  "mode": { "const": "ENTER_VALUE" },
                  "prompt": { "type": "string", "minLength": 1 },
                  "expectedValue": { "type": "number" },
                  "tolerance": { "type": "number", "minimum": 0 },
                  "feedback": { "$ref": "#/$defs/itemFeedback" }
                }
              }
            ]
          }
        }
      }
    }
  ]
}
