{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.questcity.dev/web/drag-drop-config.schema.json",
  "title": "DragDropConfig",
  "description": "R3C.1. Configuration for ENG-DRAG / QC-WEB-ENGINE-DRAG-DROP (07_10 §4, published originally in v1.0). Generic item/target classification-association, no Balance Machine-specific semantics. M06 Web Full Vertical Slice Tranche 4 (07_26 v1.0 §5/§13): added optional display text and evidence-derived feedback text, both backward compatible.",
  "type": "object",
  "additionalProperties": false,
  "required": ["items", "targets", "correctMapping"],
  "properties": {
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["itemId"],
        "properties": {
          "itemId": { "type": "string", "minLength": 1 },
          "text": { "type": "string", "minLength": 1 }
        }
      }
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["targetId"],
        "properties": {
          "targetId": { "type": "string", "minLength": 1 },
          "text": { "type": "string", "minLength": 1 }
        }
      }
    },
    "correctMapping": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["itemId", "targetId"],
        "properties": {
          "itemId": { "type": "string", "minLength": 1 },
          "targetId": { "type": "string", "minLength": 1 }
        }
      }
    },
    "feedback": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "correctFeedbackText": { "type": "string", "minLength": 1 },
        "partialFeedbackText": { "type": "string", "minLength": 1 },
        "incorrectFeedbackText": { "type": "string", "minLength": 1 }
      }
    }
  }
}
