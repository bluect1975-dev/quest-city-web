{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.questcity.dev/web/attempt-context.schema.json",
  "title": "AttemptContext",
  "description": "Server-authoritative attempt context handed to the Learning Runtime Host (07_05 §10). The client holds a presentational projection only; the server owns the authoritative state.",
  "type": "object",
  "additionalProperties": false,
  "required": ["attemptId", "activityId", "studentPublicId", "runtimeChannel", "status", "sequenceNumber"],
  "properties": {
    "attemptId": { "type": "string", "minLength": 1 },
    "activityId": { "type": "string", "minLength": 1 },
    "studentPublicId": { "type": "string", "minLength": 1 },
    "runtimeChannel": { "type": "string", "enum": ["WEB", "ROBLOX"] },
    "status": {
      "type": "string",
      "enum": ["created", "in_progress", "submitted", "evaluated", "abandoned"]
    },
    "sequenceNumber": { "type": "integer", "minimum": 0 }
  }
}
