# Quest City Web — environment template.
# Copy to .env for local development: cp .env.example .env
# No real secrets belong in this file or in any committed file.
# Per 07_06 (VPS Deployment, Security and Operations Specification): PostgreSQL
# must never be reachable from a public interface. In local/dev this file
# only points at the docker-compose-provisioned internal Postgres instance.

# --- Shared ---
NODE_ENV=development
LOG_LEVEL=info

# --- apps/api ---
API_PORT=4000
# Host-side connection string for local tooling (migrations, psql) reaching
# the docker-compose Postgres container. Port 5434, not the default 5432,
# to avoid colliding with PostgreSQL instances already running natively on
# your machine — see infrastructure/deployment/docker-compose.yml. Inside
# the Docker network, apps/api itself connects to postgres:5432 (set
# directly in docker-compose.yml, not from this file).
DATABASE_URL=postgresql://quest_city_web:changeme_local_only@localhost:5434/quest_city_web
DATABASE_SSL=false
# Upper bound for the readiness probe's DB round-trip before failing closed.
HEALTH_READY_DB_TIMEOUT_MS=2000

# --- apps/student-web ---
STUDENT_WEB_PORT=3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# --- apps/dashboard ---
DASHBOARD_PORT=3001
NEXT_PUBLIC_API_BASE_URL_DASHBOARD=http://localhost:4000

# --- Session / cookies (WEB-M1 Fase 2) ---
# Real values are provisioned per-environment via the secret store described
# in 07_06 §9; never committed here beyond these non-secret defaults.
# Session cookies are HttpOnly/Secure/SameSite=Lax, never persistent tokens
# in localStorage (07_16 / 02_27 / AGENTS.md WEB-M1 baseline).
SESSION_COOKIE_NAME=qc_web_session
# 12h absolute / 60min inactivity (WEB-M1 Fase 2 correction report §5).
SESSION_ABSOLUTE_TTL_SECONDS=43200
SESSION_INACTIVITY_TTL_SECONDS=3600
# Origins allowed to perform mutating /web-auth/* requests (CSRF Origin
# check). Comma-separated. Defaults to the local student-web dev server and
# the local Nginx-fronted URL.
WEB_AUTH_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:8080
# NEVER set to true outside NODE_ENV=development — the code refuses this
# override in staging/production regardless of this value (WEB-M1 Fase 2
# correction report §6). Only needed if your local browser/tooling does not
# already accept a Secure cookie over http://localhost.
SESSION_COOKIE_SECURE_OVERRIDE_INSECURE_LOCAL=false

# --- Staff session / cookies (WEB-M3B, 02_35 §4.4) ---
# Entirely separate cookie/table from the student session above — never the
# same name or row (02_35 §2.1).
STAFF_SESSION_COOKIE_NAME=qc_staff_session
STAFF_SESSION_ABSOLUTE_TTL_SECONDS=43200
STAFF_SESSION_INACTIVITY_TTL_SECONDS=3600
# Origins allowed to perform mutating staff-auth/dashboard requests. Separate
# list from WEB_AUTH_TRUSTED_ORIGINS since apps/dashboard runs on its own origin.
STAFF_AUTH_TRUSTED_ORIGINS=http://localhost:3001,http://localhost:8080

# HMAC-SHA-256 key for class-code hashing (WEB-M1 Fase 2 correction #1).
# REQUIRED in every environment — there is no default and none is ever
# committed here (left empty on purpose). The app and the seed script both
# refuse to start without it, or if it decodes to fewer than 32 bytes.
# Real staging/production values are provisioned via the secret store
# (07_06 §9), never in this file or any committed file. Generate your own
# local value with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CLASS_CODE_HASH_PEPPER=

# --- Master Admin Operations Control Center: Telegram alert channel (02_42 §30, 07_06 §9) ---
# OPTIONAL. Leave both empty for local dev/CI: apps/api/lib/operations-context.ts
# falls back to LocalMockAlertChannelAdapter automatically, no Telegram account
# needed. Set both (never just one) in staging/production via the secret store
# (07_06 §9) to enable real delivery -- `infrastructure/scripts/bootstrap.sh`
# then provisions `alert_configuration.recipient_ref`/`credential_ref`
# automatically (idempotent; see tools/provision-telegram-alert-channel.ts), so
# no manual SQL UPDATE is ever required. Server-side only: never read by the
# dashboard or student-web apps, never a NEXT_PUBLIC_* variable, never logged.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
