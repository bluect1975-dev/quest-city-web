# Quest City Web — environment template.
# Copy to .env for local development: cp .env.example .env
# No real secrets belong in this file or in any committed file.
# Per 07_06 (VPS Deployment, Security and Operations Specification): PostgreSQL
# must never be reachable from a public interface. In local/dev this file
# only points at the docker-compose-provisioned internal Postgres instance.

# --- Shared ---
NODE_ENV=development
LOG_LEVEL=info

# --- apps/api ---
API_PORT=4000
# Host-side connection string for local tooling (migrations, psql) reaching
# the docker-compose Postgres container. Port 5434, not the default 5432,
# to avoid colliding with PostgreSQL instances already running natively on
# your machine — see infrastructure/deployment/docker-compose.yml. Inside
# the Docker network, apps/api itself connects to postgres:5432 (set
# directly in docker-compose.yml, not from this file).
DATABASE_URL=postgresql://quest_city_web:changeme_local_only@localhost:5434/quest_city_web
DATABASE_SSL=false
# Upper bound for the readiness probe's DB round-trip before failing closed.
HEALTH_READY_DB_TIMEOUT_MS=2000

# --- apps/student-web ---
STUDENT_WEB_PORT=3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# --- apps/dashboard ---
DASHBOARD_PORT=3001
NEXT_PUBLIC_API_BASE_URL_DASHBOARD=http://localhost:4000

# --- Session / cookies (placeholders only — no auth implemented at WEB-M0) ---
# Real values are provisioned per-environment via the secret store described
# in 07_06 §9; never committed here. Left as documented names only, per
# 07_16 / 02_27: session cookies are HttpOnly/Secure/SameSite, never
# persistent tokens in localStorage.
SESSION_COOKIE_NAME=qc_web_session
